# ============================================================
# The Lenny Growth Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- LLM Provider Configuration ---
# Options: "ollama" | "anthropic" | "openai"
# Default: ollama (zero-cost local inference, no API key required)
LLM_PROVIDER=ollama

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b

# --- Anthropic (Cloud) ---
# Uncomment and set to use Claude models
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (Cloud) ---
# Uncomment and set to use GPT models
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# --- PostgreSQL ---
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny_growth_assistant
DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev_password@db:5432/lenny_growth_assistant

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=info

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- RAG Pipeline ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
